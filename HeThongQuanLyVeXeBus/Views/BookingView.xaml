<UserControl x:Class="HeThongQuanLyVeXeBus.Views.BookingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:HeThongQuanLyVeXeBus.ViewModels"
             xmlns:b="clr-namespace:HeThongQuanLyVeXeBus.Views.Behaviors"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="640"
             d:DataContext="{d:DesignInstance Type=vm:BookingViewModel}"
             Language="vi-VN">
    <UserControl.Resources>
        <ResourceDictionary Source="/HeThongQuanLyVeXeBus;component/Resources/Styles.xaml"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="400"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.ColumnSpan="2" Text="Bán vé" Style="{StaticResource PageTitle}"/>

        <!-- Thông tin hành khách -->
        <Border Grid.Row="1" Style="{StaticResource PanelCard}" Margin="0,0,16,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Chuyến xe *"/>
                    <ComboBox ItemsSource="{Binding OpenTrips}" SelectedItem="{Binding SelectedTrip}"
                              DisplayMemberPath="DisplaySummary"/>
                    <TextBlock Text="Tên khách hàng *"/>
                    <TextBox Text="{Binding CustomerName, UpdateSourceTrigger=PropertyChanged}" b:FocusBehavior.Key="CustomerName"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Số điện thoại *"/>
                            <TextBox Text="{Binding CustomerPhone, UpdateSourceTrigger=PropertyChanged}"
                                     b:FocusBehavior.Key="CustomerPhone"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Email (không bắt buộc)"/>
                            <TextBox Text="{Binding CustomerEmail, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="Điểm đón *"/>
                    <TextBox Text="{Binding PickupPoint, UpdateSourceTrigger=PropertyChanged}" b:FocusBehavior.Key="PickupPoint"/>
                    <TextBlock Text="Điểm trả *"/>
                    <TextBox Text="{Binding DropoffPoint, UpdateSourceTrigger=PropertyChanged}" b:FocusBehavior.Key="DropoffPoint"/>
                    <TextBlock Text="Thanh toán *"/>
                    <ComboBox ItemsSource="{Binding PaymentMethods}" SelectedItem="{Binding PaymentMethod}"/>
                    <TextBlock Text="Chỉ bán vé sau khi đã nhận tiền mặt hoặc đã kiểm tra chuyển khoản."
                               Style="{StaticResource Hint}"/>
                    <Button Content="Bán vé" Command="{Binding BookCommand}"
                            Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Vé vừa bán / vé đang chọn và nút lưu PDF -->
        <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource PanelCard}" VerticalAlignment="Top">
            <StackPanel>
                <TextBlock Text="Vé PDF" Style="{StaticResource SectionTitle}"/>
                <TextBlock Text="{Binding BookingResult}" TextWrapping="Wrap" FontWeight="SemiBold" Foreground="#153E48"/>
                <Button Content="Lưu vé thành PDF" Command="{Binding ExportPdfCommand}"
                        Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,8,0,8"/>
                <TextBlock Text="Vé vừa bán sẽ hiện ở đây. Muốn in lại vé cũ: chọn vé ở mục Vé / soát vé rồi quay lại đây."
                           Style="{StaticResource Hint}"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
