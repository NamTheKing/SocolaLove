<UserControl x:Class="HeThongQuanLyVeXeBus.Views.RevenueView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:HeThongQuanLyVeXeBus.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="640"
             d:DataContext="{d:DesignInstance Type=vm:RevenueViewModel}"
             Language="vi-VN">
    <UserControl.Resources>
        <ResourceDictionary Source="/HeThongQuanLyVeXeBus;component/Resources/Styles.xaml"/>
    </UserControl.Resources>

    <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="Doanh thu" Style="{StaticResource PageTitle}"/>

        <!-- Chọn kỳ báo cáo (theo ngày bán vé) và tuyến -->
        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,14">
            <StackPanel Margin="0,0,12,0">
                <TextBlock Text="Từ ngày bán" Style="{StaticResource StatLabel}"/>
                <DatePicker SelectedDate="{Binding FromDate}" Width="140" Margin="0"/>
            </StackPanel>
            <StackPanel Margin="0,0,12,0">
                <TextBlock Text="Đến ngày bán" Style="{StaticResource StatLabel}"/>
                <DatePicker SelectedDate="{Binding ToDate}" Width="140" Margin="0"/>
            </StackPanel>
            <StackPanel Margin="0,0,12,0">
                <TextBlock Text="Tuyến" Style="{StaticResource StatLabel}"/>
                <ComboBox ItemsSource="{Binding RouteChoices}" SelectedItem="{Binding SelectedRouteChoice}"
                          DisplayMemberPath="Label" Width="200" Margin="0"/>
            </StackPanel>
            <Button Content="Xem báo cáo" Command="{Binding ApplyCommand}" Style="{StaticResource PrimaryButton}"
                    VerticalAlignment="Bottom" Margin="0,0,8,0"/>
            <Button Content="Xuất Excel" Command="{Binding ExportExcelCommand}" VerticalAlignment="Bottom" Margin="0"/>
        </WrapPanel>

        <!-- Bốn số liệu chính -->
        <UniformGrid DockPanel.Dock="Top" Columns="4" Margin="0,0,-12,0">
            <Border Style="{StaticResource StatCard}">
                <StackPanel>
                    <TextBlock Text="Doanh thu" Style="{StaticResource StatLabel}"/>
                    <TextBlock Text="{Binding Report.Revenue, StringFormat={}{0:N0} ₫}" Style="{StaticResource StatValue}"
                               Foreground="{StaticResource Accent}"/>
                    <TextBlock Text="Vé đã bán, chưa hủy" Style="{StaticResource Hint}" Margin="0"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource StatCard}">
                <StackPanel>
                    <TextBlock Text="Vé hợp lệ" Style="{StaticResource StatLabel}"/>
                    <TextBlock Text="{Binding Report.ActiveCount, StringFormat={}{0:N0}}" Style="{StaticResource StatValue}"/>
                    <TextBlock Text="{Binding Report.CheckedInCount, StringFormat='Đã soát: {0:N0}'}" Style="{StaticResource Hint}" Margin="0"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource StatCard}">
                <StackPanel>
                    <TextBlock Text="Vé đã hủy" Style="{StaticResource StatLabel}"/>
                    <TextBlock Text="{Binding Report.CancelledCount, StringFormat={}{0:N0}}" Style="{StaticResource StatValue}"/>
                    <TextBlock Text="Không tính vào doanh thu" Style="{StaticResource Hint}" Margin="0"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource StatCard}">
                <StackPanel>
                    <TextBlock Text="Chờ hoàn tiền" Style="{StaticResource StatLabel}"/>
                    <TextBlock Text="{Binding Report.PendingRefundValue, StringFormat={}{0:N0} ₫}" Style="{StaticResource StatValue}"/>
                    <TextBlock Text="{Binding Report.PendingRefundCount, StringFormat='Số vé: {0:N0}'}" Style="{StaticResource Hint}" Margin="0"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <TextBlock DockPanel.Dock="Top" Text="Doanh thu theo tuyến" Style="{StaticResource SectionTitle}" Margin="0,4,0,8"/>
        <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Hint}" Margin="0,8,0,0"
                   Text="Doanh thu chỉ tính vé chưa hủy. Bấm Xuất Excel để xem chi tiết theo từng chuyến và từng vé."/>
        <TextBlock DockPanel.Dock="Bottom" Text="Không có vé nào được bán trong khoảng thời gian đã chọn."
                   Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" Margin="0,8,0,0"/>

        <DataGrid ItemsSource="{Binding Report.Routes}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Tuyến" Binding="{Binding RouteName}" Width="*"/>
                <DataGridTextColumn Header="Vé hợp lệ" Binding="{Binding ActiveTickets}" Width="110"/>
                <DataGridTextColumn Header="Đã soát" Binding="{Binding CheckedInTickets}" Width="100"/>
                <DataGridTextColumn Header="Đã hủy" Binding="{Binding CancelledTickets}" Width="100"/>
                <DataGridTextColumn Header="Doanh thu (₫)" Binding="{Binding Revenue, StringFormat={}{0:N0}}" Width="150"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
