<UserControl x:Class="HeThongQuanLyVeXeBus.Views.TicketsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:HeThongQuanLyVeXeBus.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="640"
             d:DataContext="{d:DesignInstance Type=vm:TicketsViewModel}"
             Language="vi-VN">
    <UserControl.Resources>
        <ResourceDictionary Source="/HeThongQuanLyVeXeBus;component/Resources/Styles.xaml"/>
    </UserControl.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Top" Style="{StaticResource PanelCard}" Padding="17,14" Margin="0,0,0,14">
            <WrapPanel>
                <TextBlock Text="TRA CỨU VÉ" FontWeight="Bold" Foreground="#345064" Margin="0,9,16,0"/>
                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Width="390"
                         ToolTip="Nhập mã vé, khách, số điện thoại hoặc mã chuyến"/>
                <Button Content="Làm mới" Command="{Binding RefreshCommand}"/>
                <Button Content="Xuất Excel danh sách đang hiển thị" Command="{Binding ExportExcelCommand}"
                        Style="{StaticResource PrimaryButton}"/>
            </WrapPanel>
        </Border>
        <Border DockPanel.Dock="Bottom" Style="{StaticResource PanelCard}" Padding="17,12" Margin="0,14,0,0">
            <StackPanel>
                <TextBlock Text="{Binding TicketDetail}" TextWrapping="Wrap" Foreground="#345064" Margin="0,0,0,10"/>
                <WrapPanel>
                    <Button Content="Quét QR bằng camera" Command="{Binding ScanQrCommand}"/>
                    <Button Content="Soát vé / lên xe" Command="{Binding CheckInCommand}" Style="{StaticResource PrimaryButton}"/>
                    <Button Content="Hủy vé" Command="{Binding CancelTicketCommand}" Style="{StaticResource DangerButton}"/>
                    <Button Content="Xác nhận đã hoàn tiền" Command="{Binding MarkRefundedCommand}"/>
                </WrapPanel>
                <TextBlock Text="Khi hủy vé, chọn đã hoàn hoặc chưa hoàn tiền. Chỉ xác nhận đã hoàn sau khi thực trả tiền cho khách."
                           TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="12"/>
            </StackPanel>
        </Border>
        <DataGrid ItemsSource="{Binding VisibleTickets}" SelectedItem="{Binding SelectedTicket}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Mã vé" Binding="{Binding TicketCode}" Width="145"/>
                <DataGridTextColumn Header="Chuyến" Binding="{Binding Trip.TripCode}" Width="145"/>
                <DataGridTextColumn Header="Khách" Binding="{Binding CustomerName}" Width="210"/>
                <DataGridTextColumn Header="SĐT" Binding="{Binding CustomerPhone}" Width="120"/>
                <DataGridTextColumn Header="Giá" Binding="{Binding Price, StringFormat={}{0:N0}}" Width="100"/>
                <DataGridTextColumn Header="Trạng thái / hoàn tiền" Binding="{Binding StatusText}" Width="230"/>
                <DataGridTextColumn Header="Ngày hoàn tiền" Binding="{Binding RefundedAt, StringFormat={}{0:dd/MM/yyyy HH:mm}}" Width="160"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
