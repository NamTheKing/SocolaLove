<Window x:Class="HeThongQuanLyVeXeBus.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:HeThongQuanLyVeXeBus.ViewModels"
        xmlns:views="clr-namespace:HeThongQuanLyVeXeBus.Views"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="Quản lý vé xe liên tỉnh" Height="760" Width="1280" MinHeight="620" MinWidth="1000"
        FontFamily="Segoe UI" FontSize="14" Foreground="#172B3A" Background="#F4F7FA" Language="vi-VN"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/HeThongQuanLyVeXeBus;component/Resources/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Mỗi TabItem là một mục trong menu bên trái. -->
            <Style TargetType="TabItem">
                <Setter Property="Foreground" Value="#C5D7DD"/>
                <Setter Property="FontSize" Value="15"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TabItem">
                            <Border x:Name="Item" Background="Transparent" CornerRadius="8"
                                    Padding="14,10" Margin="0,0,0,4">
                                <TextBlock Text="{TemplateBinding Header}" Foreground="{TemplateBinding Foreground}"
                                           FontSize="{TemplateBinding FontSize}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Item" Property="Background" Value="#1F4356"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Item" Property="Background" Value="#087F78"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Menu bên trái, nội dung trang bên phải. -->
            <Style TargetType="TabControl">
                <Setter Property="TabStripPlacement" Value="Left"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TabControl">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Background="#102C3E" Padding="12,20">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Top" Text="QUẢN LÝ VÉ XE" Foreground="White"
                                                   FontSize="17" FontWeight="Bold" Margin="14,0,0,22"/>
                                        <TabPanel IsItemsHost="True"/>
                                    </DockPanel>
                                </Border>
                                <ContentPresenter x:Name="PART_SelectedContentHost" Grid.Column="1"
                                                  ContentSource="SelectedContent" Margin="24,20"/>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <DockPanel>
        <!-- Thanh trạng thái: thông báo kết quả thao tác hoặc lỗi. -->
        <Border DockPanel.Dock="Bottom" Background="White" BorderBrush="#E4EAF0" BorderThickness="0,1,0,0" Padding="16,6">
            <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" Foreground="#245A5B" FontSize="12"
                       AutomationProperties.LiveSetting="Assertive" MinHeight="20"/>
        </Border>

        <!-- Mỗi tab là một View riêng, DataContext là ViewModel con tương ứng của MainViewModel. -->
        <TabControl SelectedIndex="{Binding SelectedTabIndex}">
            <TabItem Header="Tổng quan">
                <views:DashboardView DataContext="{Binding Dashboard}"/>
            </TabItem>
            <TabItem Header="Tuyến xe">
                <views:RoutesView DataContext="{Binding Routes}"/>
            </TabItem>
            <TabItem Header="Đội xe">
                <views:BusesView DataContext="{Binding Buses}"/>
            </TabItem>
            <TabItem Header="Chuyến xe">
                <views:TripsView DataContext="{Binding Trips}"/>
            </TabItem>
            <TabItem Header="Bán vé">
                <views:BookingView DataContext="{Binding Booking}"/>
            </TabItem>
            <TabItem Header="Vé / soát vé">
                <views:TicketsView DataContext="{Binding Tickets}"/>
            </TabItem>
            <TabItem Header="Doanh thu">
                <views:RevenueView DataContext="{Binding Revenue}"/>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
