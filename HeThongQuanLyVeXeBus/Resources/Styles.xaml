<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        Kiểu dáng dùng chung cho cửa sổ chính và các View (UserControl).
        Mỗi View tự gộp tệp này vào Resources của nó để trình thiết kế XAML
        của Visual Studio hiển thị đúng; không đặt ở App.xaml vì kiểu TextBlock
        ngầm định ở cấp Application sẽ đè lên chữ bên trong Button/ComboBox.
    -->
    <SolidColorBrush x:Key="Accent" Color="#087F78"/>
    <SolidColorBrush x:Key="Muted" Color="#64748B"/>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

    <Style TargetType="TextBlock">
        <Setter Property="Margin" Value="0,3,0,3"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="#345064"/>
    </Style>
    <Style x:Key="SectionTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="21"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="#122B3A"/>
        <Setter Property="Margin" Value="0,0,0,4"/>
    </Style>
    <Style x:Key="SectionHint" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource Muted}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin" Value="0,0,0,18"/>
    </Style>
    <Style x:Key="PanelCard" TargetType="Border">
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="#E4EAF0"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="14"/>
    </Style>
    <Style TargetType="TextBox">
        <Setter Property="Margin" Value="0,0,0,12"/>
        <Setter Property="MinHeight" Value="38"/>
        <Setter Property="Padding" Value="10,5"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="#CDD8E1"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style TargetType="ComboBox">
        <Setter Property="Margin" Value="0,0,0,12"/>
        <Setter Property="MinHeight" Value="38"/>
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="#CDD8E1"/>
    </Style>
    <Style TargetType="DatePicker">
        <Setter Property="Margin" Value="0,0,0,12"/>
        <Setter Property="MinHeight" Value="38"/>
        <Setter Property="BorderBrush" Value="#CDD8E1"/>
    </Style>
    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="#33485A"/>
        <Setter Property="Margin" Value="0,6,0,10"/>
    </Style>
    <Style TargetType="Button">
        <Setter Property="Background" Value="White"/>
        <Setter Property="Foreground" Value="#244558"/>
        <Setter Property="BorderBrush" Value="#C9D8E1"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="15,8"/>
        <Setter Property="Margin" Value="0,6,10,6"/>
        <Setter Property="MinHeight" Value="38"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#EAF5F3"/>
                <Setter Property="BorderBrush" Value="#8BBDB7"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{StaticResource Accent}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#066A65"/>
                <Setter Property="BorderBrush" Value="#066A65"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Foreground" Value="#AF353D"/>
        <Setter Property="BorderBrush" Value="#EFC9CC"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#FFF0F0"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style TargetType="DataGrid">
        <Setter Property="AutoGenerateColumns" Value="False"/>
        <Setter Property="IsReadOnly" Value="True"/>
        <Setter Property="SelectionMode" Value="Single"/>
        <Setter Property="CanUserAddRows" Value="False"/>
        <Setter Property="HeadersVisibility" Value="Column"/>
        <Setter Property="GridLinesVisibility" Value="Horizontal"/>
        <Setter Property="HorizontalGridLinesBrush" Value="#EDF1F5"/>
        <Setter Property="RowBackground" Value="White"/>
        <Setter Property="AlternatingRowBackground" Value="#F8FAFC"/>
        <Setter Property="BorderBrush" Value="#E4EAF0"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Background" Value="White"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="RowHeight" Value="43"/>
        <Setter Property="ColumnHeaderHeight" Value="46"/>
    </Style>
    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="#EDF3F6"/>
        <Setter Property="Foreground" Value="#345064"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="10,0"/>
        <Setter Property="BorderBrush" Value="#E4EAF0"/>
        <Setter Property="BorderThickness" Value="0,0,1,1"/>
    </Style>
    <Style TargetType="DataGridRow">
        <Setter Property="BorderThickness" Value="0"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#E7F5F2"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="#D2EEEA"/>
                <Setter Property="Foreground" Value="#123D42"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style TargetType="DataGridCell">
        <Setter Property="Padding" Value="10,0"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
</ResourceDictionary>
